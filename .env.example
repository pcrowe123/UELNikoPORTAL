# UEL / Niko Portal - the names of every value the project uses.
# Copy the ones you need into the right file and fill them in. This file holds names only:
# nothing secret is ever committed.
#
#   .env.local   Public build values. Vite copies these into the browser bundle, so ONLY
#                values that are safe to publish (Row Level Security protects the data).
#                NEVER put a secret behind a VITE_ name.
#   .env         Project bookkeeping used by the scripts in scripts/ (never by the browser).
#   .dev.vars    Service-role material for local scripts. The most dangerous file here.

# ---------------------------------------------------------------- .env.local (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- .env (scripts)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ORG_ID=
APP_URL=https://uelnikoportal.com
# Resend SMTP password, used by Supabase Auth to send invitation and password-reset mail.
SMTP_PASS=

# ---------------------------------------------------------------- .dev.vars (service role)
SUPABASE_SERVICE_ROLE_KEY=
